---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'input'>

const props = Astro.props
---

<input {...props} />

<style>
  input {
    width: 100%;
    max-width: 100%;
    height: var(--control-height);
    padding-inline: 16px;
    border: 1px solid var(--color-field-border);
    border-radius: var(--radius-field);
    background-color: var(--color-field-bg);
    color: var(--color-text);
    transition: border-color 180ms ease;
  }

  input::placeholder {
    color: var(--color-field-placeholder);
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    input:hover {
      border-color: var(--color-field-placeholder);
    }
  }

  input[aria-invalid='true'] {
    border-color: var(--color-accent);
  }

  input:focus-visible {
    border-color: var(--color-text);
    outline: 3px solid color-mix(in srgb, var(--color-text) 12%, transparent);
    outline-offset: 0;
  }

  input[aria-invalid='true']:focus-visible {
    border-color: var(--color-accent);
    outline-color: color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  input:active {
    border-color: var(--color-text);
  }

  input[aria-invalid='true']:active {
    border-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    input {
      transition: none;
    }
  }
</style>
