---
import type { HTMLTag, Polymorphic } from 'astro/types'

type Props<Tag extends HTMLTag = 'button'> = Polymorphic<{ as: Tag }> & {
  variant?: 'ink' | 'accent' | 'outline'
  size?: 'md' | 'lg'
}

const {
  as: Tag = 'button',
  class: className,
  variant = 'ink',
  size = 'md',
  ...attrs
} = Astro.props
---

<Tag
  class:list={['base-button', `variant-${variant}`, `size-${size}`, className]}
  {...attrs}
>
  <slot />
</Tag>

<style>
  .base-button {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
    min-inline-size: 185px;
    min-block-size: var(--control-height);
    padding: 12px 38px;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.05em;
    text-align: center;
    text-transform: uppercase;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition:
      background-color 180ms cubic-bezier(0.2, 0.8, 0.25, 1),
      border-color 180ms cubic-bezier(0.2, 0.8, 0.25, 1),
      transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .size-lg {
    min-inline-size: 205px;
    min-block-size: 64px;
  }

  .variant-ink {
    background-color: var(--color-surface-inverse);
    color: var(--color-text-on-inverse);
  }

  .variant-accent {
    background-color: var(--color-accent);
    color: var(--color-text-on-inverse);
  }

  .variant-outline {
    padding: 10px 36px;
    border: 2px solid var(--color-border-soft);
    color: var(--color-text);
  }

  @media (hover: hover) and (pointer: fine) {
    .base-button:hover {
      transform: translateY(-2px);
    }

    .variant-ink:hover {
      background-color: color-mix(
        in srgb,
        var(--color-surface-inverse) 88%,
        #fff
      );
    }

    .variant-accent:hover {
      background-color: color-mix(in srgb, var(--color-accent) 88%, #fff);
    }

    .variant-outline:hover {
      border-color: color-mix(
        in srgb,
        var(--color-border-soft) 70%,
        var(--color-text)
      );
    }
  }

  .base-button:focus-visible {
    transform: translateY(-2px);
    outline: 2px solid var(--color-text-on-inverse);
    outline-offset: -6px;
  }

  .variant-outline:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  .base-button:active {
    transform: translateY(0) scale(0.97);
    transition-duration: 90ms;
  }

  .variant-ink:active {
    background-color: color-mix(
      in srgb,
      var(--color-surface-inverse) 85%,
      #000
    );
  }

  .variant-accent:active {
    background-color: color-mix(in srgb, var(--color-accent) 85%, #000);
  }

  .variant-outline:active {
    border-color: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .base-button {
      transition:
        background-color 180ms ease,
        border-color 180ms ease;
    }

    .base-button:focus-visible,
    .base-button:active {
      transform: none;
    }

    @media (hover: hover) and (pointer: fine) {
      .base-button:hover {
        transform: none;
      }
    }
  }
</style>
