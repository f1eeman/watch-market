---
import ProductCard from '@/components/product-card.astro'
import PromoTile from '@/components/promo-tile.astro'
import Pagination from '@/components/pagination.astro'
import { CATALOG } from '@/data/products'

const BANNER_AT = 5
---

<div class="wrap">
  <ul class="grid" id="catalog-grid">
    {
      CATALOG.map((product, index) => (
        <Fragment>
          {index === BANNER_AT && (
            <li data-enter="lift" data-enter-step="8" data-sort-pin>
              <PromoTile />
            </li>
          )}
          <li
            data-enter="lift"
            data-enter-step={String(index + 3)}
            data-sort-amount={String(product.amount)}
            data-sort-brand={product.brand}
          >
            <ProductCard
              {product}
              box={252}
              step={1100}
              loading={index < 3 ? 'eager' : 'lazy'}
            />
          </li>
        </Fragment>
      ))
    }
  </ul>

  <Pagination pages={[1, 2, 3]} current={3} total={12} />
</div>

<style>
  .wrap {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .grid {
    display: grid;
    gap: 20px;
  }

  @media (width >= 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px;
    }
  }

  @media (width >= 1024px) {
    .wrap {
      gap: 49px;
    }
  }

  @media (width >= 1100px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
