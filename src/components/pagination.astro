---
import ChevronLeft from '@/img/icons/arrow-left-sm.svg'
import ChevronRight from '@/img/icons/arrow-right-sm.svg'

interface Props {
  pages: number[]
  current: number
  total: number
}

const { pages, current, total } = Astro.props

const pageHref = (page: number): string => `?page=${String(page)}`
---

<nav class="pagination" aria-label="Страницы каталога">
  <a
    class="arrow"
    href={pageHref(current - 1)}
    aria-label="Предыдущая страница"
  >
    <ChevronLeft class="glyph" />
  </a>

  <ul class="pages">
    {
      pages.map((page) => (
        <li>
          {page === current ? (
            <span class="page current" aria-current="page">
              {page}
            </span>
          ) : (
            <a class="page" href={pageHref(page)}>
              {page}
            </a>
          )}
        </li>
      ))
    }
    <li><span class="skip" aria-hidden="true">...</span></li>
    <li>
      <a class="page" href={pageHref(total)}>{total}</a>
    </li>
  </ul>

  <a class="arrow" href={pageHref(current + 1)} aria-label="Следующая страница">
    <ChevronRight class="glyph" />
  </a>
</nav>

<style>
  .pagination {
    display: flex;
    gap: 6px;
    align-items: center;
    justify-content: flex-end;
  }

  .pages {
    display: flex;
    align-items: center;
  }

  .arrow,
  .page,
  .skip {
    display: grid;
    place-content: center;
    min-inline-size: 26px;
    min-block-size: 44px;
    line-height: 1.3;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .arrow,
  .page {
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .glyph {
    inline-size: 5px;
    block-size: 10px;
  }

  .page,
  .skip {
    color: var(--color-text-disabled);
  }

  .current {
    color: var(--color-text);
  }

  @media (hover: hover) and (pointer: fine) {
    a.page:hover,
    .arrow:hover {
      color: var(--color-text);
    }

    .arrow:hover .glyph {
      opacity: 0.6;
    }
  }

  .arrow:focus-visible,
  a.page:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: -4px;
  }

  a.page:active {
    color: var(--color-text);
    transition-duration: 90ms;
  }

  @media (width >= 1024px) {
    .pagination {
      gap: 8px;
    }

    .arrow,
    .page,
    .skip {
      min-inline-size: 14px;
      min-block-size: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow,
    .page {
      transition: none;
    }
  }
</style>
