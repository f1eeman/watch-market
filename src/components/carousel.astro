---
import ArrowLeft from '@/img/icons/arrow-left.svg'
import ArrowRight from '@/img/icons/arrow-right.svg'

interface Props {
  label: string
}

const { label } = Astro.props
---

<div class="carousel" data-carousel>
  <button
    class="arrow prev"
    type="button"
    data-carousel-prev
    aria-label="Показать предыдущие"
  >
    <ArrowLeft class="glyph" />
  </button>

  <ul
    class="track"
    data-carousel-track
    role="group"
    tabindex="0"
    aria-label={label}
  >
    <slot />
  </ul>

  <button
    class="arrow next"
    type="button"
    data-carousel-next
    aria-label="Показать следующие"
  >
    <ArrowRight class="glyph" />
  </button>
</div>

<style>
  .carousel {
    position: relative;
  }

  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 86%;
    gap: 20px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track > :global(*) {
    scroll-snap-align: start;
  }

  .track:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .arrow {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      scroll-behavior: smooth;
    }
  }

  @media (width >= 640px) {
    .track {
      grid-auto-columns: calc((100% - 40px) / 2);
      gap: 40px;
    }
  }

  @media (width >= 1024px) {
    .track {
      grid-auto-columns: calc((100% - 80px) / 3);
    }

    .arrow {
      position: absolute;
      display: grid;
      place-content: center;
      inset-block-start: 50%;
      inline-size: 12px;
      block-size: 23px;
      translate: 0 -50%;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
      transition: opacity 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
    }

    .arrow::after {
      content: '';
      position: absolute;
      inset: -11px;
    }

    .arrow:disabled {
      opacity: 0.35;
      cursor: default;
    }

    .arrow:focus-visible {
      outline: 2px solid var(--color-text);
      outline-offset: 8px;
    }

    .glyph {
      inline-size: 12px;
      block-size: 23px;
    }

    .prev {
      inset-inline-end: calc(100% + 8px);
    }

    .next {
      inset-inline-start: calc(100% + 8px);
    }

    @media (hover: hover) and (pointer: fine) {
      .arrow:hover:not(:disabled) {
        opacity: 0.55;
      }
    }

    .arrow:active:not(:disabled) {
      opacity: 0.4;
      transition-duration: 90ms;
    }
  }

  @media (width >= 1264px) {
    .prev {
      inset-inline-end: calc(100% + 40px);
    }

    .next {
      inset-inline-start: calc(100% + 39px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow {
      transition: none;
    }
  }
</style>
