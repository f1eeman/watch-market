---
import Logo from '@/components/logo.astro'
import ShopBar from '@/components/shop-bar.astro'

interface Props {
  current?: 'catalog' | 'sale' | 'delivery' | undefined
  surface?: boolean | undefined
}

const { current, surface } = Astro.props

const LINKS = [
  { href: '/catalog/', label: 'Каталог', key: 'catalog' },
  { href: '/sale/', label: 'Акции', key: 'sale' },
  { href: '/delivery/', label: 'Доставка', key: 'delivery' },
  { href: '#contacts', label: 'Контакты', key: 'contacts' },
]
---

<header class:list={['header', { surface }]}>
  <div class="container row">
    <Logo />

    <details class="menu" data-menu>
      <summary
        class="menu-toggle"
        data-menu-toggle
        data-menu-label-open="Открыть меню"
        data-menu-label-close="Закрыть меню"
      >
        <span class="visually-hidden" data-menu-label>Открыть меню</span>
        <span class="burger" aria-hidden="true"></span>
      </summary>
      <nav class="nav" aria-label="Разделы магазина">
        <ul class="nav-list">
          {
            LINKS.map((link) => (
              <li>
                <a
                  class="nav-link"
                  href={link.href}
                  aria-current={link.key === current ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <ShopBar />
  </div>
</header>

<script>
  import { initMenu } from '@/scripts/menu'

  initMenu()
</script>

<style>
  .header {
    position: relative;
    z-index: 1;
    padding-block-start: 28px;
  }

  .surface {
    background-color: var(--color-surface);
  }

  .row {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    min-block-size: 26px;
  }

  .nav-link {
    display: block;
    font-size: 14px;
    color: var(--color-text-muted);
    white-space: nowrap;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .nav-link[aria-current] {
    color: var(--color-accent);
  }

  @media (width < 1024px) {
    .menu {
      flex: none;
      order: 2;
    }

    .menu-toggle {
      position: relative;
      display: grid;
      place-content: center;
      inline-size: 44px;
      block-size: 44px;
      list-style: none;
      cursor: pointer;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }

    .menu-toggle::-webkit-details-marker {
      display: none;
    }

    .menu-toggle:focus-visible {
      outline: 2px solid var(--color-text);
      outline-offset: -6px;
    }

    .burger,
    .burger::before,
    .burger::after {
      inline-size: 20px;
      block-size: 1px;
      background-color: var(--color-text);
      transition:
        transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1),
        background-color 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
    }

    .burger {
      position: relative;
    }

    .burger::before,
    .burger::after {
      content: '';
      position: absolute;
      inset-inline-start: 0;
    }

    .burger::before {
      inset-block-start: -6px;
    }

    .burger::after {
      inset-block-start: 6px;
    }

    @media (hover: hover) and (pointer: fine) {
      .menu[open] .menu-toggle:hover .burger {
        background-color: transparent;
      }
    }

    .menu[open] .burger {
      background-color: transparent;
    }

    .menu[open] .burger::before {
      transform: translateY(6px) rotate(45deg);
    }

    .menu[open] .burger::after {
      transform: translateY(-6px) rotate(-45deg);
    }

    .menu::details-content {
      transition: content-visibility 180ms allow-discrete;
    }

    .nav {
      position: absolute;
      inset-inline: 0;
      inset-block-start: calc(100% + 28px);
      z-index: 10;
      block-size: 0;
      background-color: var(--color-surface-inverse);
      overflow: hidden;
      transition: block-size 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
    }

    .menu[open] .nav {
      block-size: auto;
    }

    .nav-list {
      max-block-size: calc(100dvh - 82px);
      padding: 8px var(--layout-gutter) 16px;
      overflow-y: auto;
    }

    .nav-link {
      padding-block: 10px;
      color: var(--color-text-on-inverse-muted);
      transition-property: color, background-color;
    }

    .nav-link[aria-current] {
      color: var(--color-accent);
    }

    @media (hover: hover) and (pointer: fine) {
      .nav-link:hover {
        color: var(--color-text-on-inverse);
      }
    }

    .nav-link:active {
      background-color: rgb(255 255 255 / 5%);
      color: var(--color-text-on-inverse);
    }
  }

  @media (width >= 1024px) {
    .menu {
      flex: 1;
      order: 0;
    }

    .menu-toggle {
      display: none;
    }

    .menu::details-content {
      block-size: auto;
      content-visibility: visible;
    }

    .nav-list {
      display: flex;
      gap: 65px;
      justify-content: center;
    }

    .nav-link {
      position: relative;
    }

    .nav-link::after {
      content: '';
      position: absolute;
      inset-block-end: -4px;
      inset-inline: 0;
      block-size: 1px;
      background-color: currentcolor;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
    }

    .nav-link:focus-visible {
      outline: 2px solid var(--color-text);
      outline-offset: 4px;
    }

    .nav-link:active {
      color: var(--color-text);
      transform: scale(0.97);
    }

    @media (hover: hover) and (pointer: fine) {
      .nav-link:hover {
        color: var(--color-text);
      }

      .nav-link:hover::after {
        transform: scaleX(1);
        transform-origin: left;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav-link,
    .nav-link::after,
    .burger,
    .burger::before,
    .burger::after,
    .menu::details-content {
      transition: none;
    }

    .nav-link:active {
      transform: none;
    }
  }
</style>
