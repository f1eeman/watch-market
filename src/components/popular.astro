---
import Strip from '@/components/strip.astro'
import ShowcaseCard from '@/components/showcase-card.astro'
import { POPULAR } from '@/data/products'

interface Props {
  motion?: 'reveal' | 'enter'
}

const { motion = 'reveal' } = Astro.props
---

<section
  class="popular section"
  id="popular"
  data-band
  data-parallax-scene
  aria-labelledby="popular-title"
>
  <div class="container">
    <Strip
      title="Популярные модели"
      id="popular-title"
      align="center"
      allHref="/catalog/"
    />

    <ul
      class="grid"
      data-reveal={motion === 'reveal' ? 'up' : undefined}
      data-reveal-stagger={motion === 'reveal' ? '' : undefined}
    >
      {
        POPULAR.map((product, index) => (
          <li
            data-enter={motion === 'enter' ? 'lift' : undefined}
            data-enter-step={motion === 'enter' ? String(index + 3) : undefined}
          >
            <ShowcaseCard {product} {index} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .popular {
    padding-block: 40px;
    background-color: var(--color-page);
  }

  .grid {
    display: grid;
    gap: 20px;
    margin-block-start: 32px;
  }

  @media (width >= 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 30px;
    }
  }

  @media (width >= 1024px) {
    .popular {
      padding-block: 79px 86px;
    }

    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-block-start: 37px;
    }
  }
</style>
