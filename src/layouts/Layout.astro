---
import { Font } from 'astro:assets'
import Seo from '@/components/seo.astro'
import Header from '@/components/header.astro'
import Footer from '@/components/footer.astro'

import '@/styles/index.css'

interface Props {
  title: string
  description: string
  current?: 'catalog' | 'sale' | 'delivery' | undefined
  surface?: boolean | undefined
}

const { title, description, current, surface } = Astro.props
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo {title} {description} />
    <Font cssVariable="--font-roboto" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-playfair" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-prata" />
  </head>
  <body>
    <Header {current} {surface} />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import { initReveal } from '@/scripts/reveal'
      import { initParallax } from '@/scripts/parallax'
      import { initSweep } from '@/scripts/sweep'
      import { initStroke } from '@/scripts/stroke'
      import { initTilt } from '@/scripts/tilt'
      import { initCarousel } from '@/scripts/carousel'
      import { initGallery } from '@/scripts/gallery'
      import { initTabs } from '@/scripts/tabs'
      import { initPriceRange } from '@/scripts/price-range'
      import { initBag } from '@/scripts/bag'
      import { initSearch } from '@/scripts/search'
      import { initSort } from '@/scripts/sort'

      initReveal()
      initParallax()
      initSweep()
      initStroke()
      initTilt()
      initCarousel()
      initGallery()
      initTabs()
      initPriceRange()
      initBag()
      initSearch()
      initSort()
    </script>
  </body>
</html>
