---
import Layout from '@/layouts/Layout.astro'
import Breadcrumbs from '@/components/breadcrumbs.astro'
import CatalogFilter from '@/components/catalog-filter.astro'
import CatalogGrid from '@/components/catalog-grid.astro'
import Straps from '@/components/straps.astro'
import ChevronDown from '@/img/icons/chevron-down.svg'

const title = 'Мужские часы — каталог CONQUEST'
const description =
  'Мужские швейцарские часы Techne, Rado, Bvlgari, Tissot, Omega и Montblanc от 12 000 ₽. Скидка −20% на вторую позицию в чеке.'

const RULES = [
  { rule: 'popular', label: 'популярности' },
  { rule: 'cheap', label: 'цене: сначала дешёвые' },
  { rule: 'costly', label: 'цене: сначала дорогие' },
  { rule: 'brand', label: 'бренду' },
]

const CRUMBS = [
  { href: '/', label: 'Главная' },
  { href: '/catalog/', label: 'Каталог' },
  { label: 'Мужские часы' },
]
---

<Layout {title} {description} current="catalog">
  <section class="catalog section" aria-labelledby="catalog-title">
    <div class="container">
      <Breadcrumbs items={CRUMBS} />

      <div class="head">
        <h1 class="headline" id="catalog-title" data-enter data-enter-step="2">
          Мужские часы
        </h1>

        <details class="sort" data-sort="catalog-grid">
          <summary class="sort-toggle" data-enter data-enter-step="3">
            <span class="sort-label">Сортировать по:</span>
            <span class="sort-value" data-sort-value>популярности</span>
            <ChevronDown class="sort-glyph" aria-hidden="true" />
          </summary>

          <ul class="sort-menu">
            {
              RULES.map((item) => (
                <li>
                  <button
                    class="sort-option"
                    type="button"
                    data-sort-rule={item.rule}
                    data-sort-label={item.label}
                    aria-pressed={item.rule === 'popular' ? 'true' : 'false'}
                  >
                    {item.label}
                  </button>
                </li>
              ))
            }
          </ul>
        </details>
      </div>

      <div class="body">
        <CatalogFilter />
        <CatalogGrid />
      </div>
    </div>
  </section>

  <Straps />
</Layout>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-block-start: 24px;
  }

  .sort {
    position: relative;
    align-self: flex-start;
  }

  .sort-toggle {
    display: flex;
    gap: 8px;
    align-items: center;
    min-block-size: 44px;
    list-style: none;
    font-size: 14px;
    line-height: 1.3;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .sort-toggle::-webkit-details-marker {
    display: none;
  }

  .sort-toggle:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .sort-label {
    color: var(--color-text-disabled);
  }

  .sort-value {
    color: var(--color-text);
  }

  .sort-glyph {
    flex: none;
    inline-size: 10px;
    block-size: 5px;
    transition: rotate 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .sort[open] .sort-glyph {
    rotate: 180deg;
  }

  .sort-menu {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: calc(100% + 4px);
    z-index: 20;
    inline-size: max-content;
    min-inline-size: 100%;
    padding: 8px 0;
    background-color: var(--color-surface);
    box-shadow: var(--shadow-photo);
  }

  .sort-option {
    display: block;
    inline-size: 100%;
    padding: 10px 20px;
    font-size: 14px;
    line-height: 1.3;
    text-align: start;
    white-space: nowrap;
    color: var(--color-text-strong);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .sort-option[aria-pressed='true'] {
    color: var(--color-accent);
  }

  .sort-option:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: -4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .sort-option:hover {
      color: var(--color-text);
    }

    .sort-toggle:hover .sort-label {
      color: var(--color-text-muted);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sort::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 180ms cubic-bezier(0.2, 0.8, 0.25, 1),
        content-visibility 180ms allow-discrete;
    }

    .sort[open]::details-content {
      block-size: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sort-glyph,
    .sort-option {
      transition: none;
    }
  }

  .body {
    display: grid;
    gap: 32px;
    margin-block-start: 32px;
  }

  @media (width >= 1024px) {
    .head {
      flex-direction: row;
      gap: 24px;
      align-items: center;
      justify-content: space-between;
      margin-block-start: 40px;
    }

    .sort {
      align-self: auto;
    }

    .sort-toggle {
      min-block-size: 26px;
    }

    .body {
      grid-template-columns: minmax(0, 230px) minmax(0, 1fr);
      gap: 94px;
      margin-block-start: 40px;
    }
  }
</style>
