---
import Layout from '@/layouts/Layout.astro'

const title = 'Политика конфиденциальности — Название продукта'
const description =
  'Политика конфиденциальности: какие данные собираются при отправке заявки и как они обрабатываются.'
---

<Layout {title} {description}>
  <section class="page">
    <div class="container">
      <h1 class="title">Политика конфиденциальности</h1>
      <p class="lead">Текст политики готовится.</p>
    </div>
  </section>
</Layout>

<style>
  .page {
    padding-block: 56px;
  }

  .title {
    font-weight: 600;
    font-size: 36px;
    line-height: 1.3;
  }

  .lead {
    margin-block-start: 24px;
    color: var(--color-text-muted);
  }

  @media (width >= 1024px) {
    .page {
      padding-block: 120px;
    }

    .title {
      font-size: 56px;
    }
  }
</style>
