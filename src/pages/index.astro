---
import Layout from '@/layouts/Layout.astro'
import Promo from '@/components/promo.astro'
import Popular from '@/components/popular.astro'
import Quality from '@/components/quality.astro'
import News from '@/components/news.astro'

const title = 'CONQUEST — швейцарские часы в наличии в Москве'
const description =
  'Коллекция «Весна/Лето 2019»: швейцарские часы в наличии в Москве и с доставкой по всему миру. Сертификаты качества, гарантии и ремонт.'
---

<Layout {title} {description} surface>
  <Promo />
  <Popular />
  <Quality />
  <News />
</Layout>
